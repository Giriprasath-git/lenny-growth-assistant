# ==============================================================================
# The Lenny Growth Assistant - Root .gitignore
# ==============================================================================

# Environment and Secrets (CRITICAL)
.env
.env.local
.env.*.local
*.env
*.pem
*.key
*.cert

# Private development documentation, internal daily reports and agile logs
# Strictly local development and planning records (MUST NOT be committed)
private-docs/
*.private.md
scratch/

# NOTE: Public assessment documentation (PRD.md, architecture.md, design.md, README.md, docs/)
# and sanitized agent transcripts / evaluation runs (e.g., agent-transcripts/, evaluations/)
# are explicitly TRACKED for version control and will be committed to GitHub.

# Python virtual environments & bytecode
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
ENV/
env/
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Testing & type checking caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*
nosetests.xml
coverage.xml
*.cover

# Node / Frontend artifacts
node_modules/
dist/
dist-ssr/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Database & local data
*.sqlite3
*.db
*.dump
*.bak
*.sql.gz
data/raw_transcripts/*
!data/raw_transcripts/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/cache/
data/chroma/
data/vector_store/
*.log

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# IDE & Editor settings
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
