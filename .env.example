# ==============================================================================
# The Lenny Growth Assistant - Environment Configuration Template
# Copy this file to .env and populate with your local values.
# NEVER commit the active .env file to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# General Application & Server Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
APP_NAME="Lenny Growth Assistant"
DEBUG=true
LOG_LEVEL=INFO
HOST=127.0.0.1
PORT=8000
ALLOWED_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# ------------------------------------------------------------------------------
# PostgreSQL Database Configuration (Host Development)
# ------------------------------------------------------------------------------
# Host, port, credentials and DB name for conversation persistence and pgvector
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=lenny_growth_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here
# Full connection string for SQLAlchemy asyncpg
# Format: postgresql+asyncpg://<USER>:<PASSWORD>@<HOST>:<PORT>/<DB>
DATABASE_URL=postgresql+asyncpg://postgres:your_postgres_password_here@127.0.0.1:5432/lenny_growth_db

# Connection Pool Settings (Optimized for 8 GB RAM machines)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30.0
DB_POOL_RECYCLE=1800
DB_ECHO=false

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported providers: "cloud" | "ollama" | "pi_agent"
# ------------------------------------------------------------------------------
DEFAULT_LLM_PROVIDER=ollama

# --- Cloud LLM Settings (Google Gemini - Free-Tier Default) ---
# Required only for Cloud LLM mode; local Ollama runs completely offline without keys
GEMINI_API_KEY=
# Documented free-tier eligible model: gemini-3.5-flash-lite (Google AI Studio)
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_MAX_TOKENS=2500
GEMINI_TEMPERATURE=0.2

# --- Legacy Cloud LLM Settings (Anthropic - Optional) ---
# Framework options: "claude_agent_sdk" (Anthropic Claude Agent SDK) | "pi_coding_agent"
AGENT_FRAMEWORK=pi_coding_agent
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Configurable legacy cloud model identifier
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_MAX_TOKENS=4096
ANTHROPIC_TEMPERATURE=0.2

# --- Local Ollama Settings ---
# Primary local development provider (tuned for 8 GB RAM Windows workstation)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_REQUEST_TIMEOUT=180
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.2

# ------------------------------------------------------------------------------
# Retrieval-Augmented Generation (RAG) & Embedding Settings
# ------------------------------------------------------------------------------
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSION=768
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.65
TRANSCRIPT_CHUNK_SIZE=500
TRANSCRIPT_CHUNK_OVERLAP=100

# ------------------------------------------------------------------------------
# Frontend Application Settings (Vite Prefix: VITE_)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://127.0.0.1:8000/api/v1
VITE_APP_TITLE="Lenny Growth Assistant"
VITE_ENABLE_MOCK_FALLBACK=false

# ------------------------------------------------------------------------------
# Pi Coding Agent SDK Bridge Settings
# ------------------------------------------------------------------------------
# Microservice running @earendil-works/pi-coding-agent on loopback (pi-agent-service)
PI_AGENT_SERVICE_URL=http://127.0.0.1:8765
PI_AGENT_TIMEOUT=180.0
PI_AGENT_MODEL=qwen2.5:1.5b
PI_AGENT_ENABLED=true

# ------------------------------------------------------------------------------
# Docker Compose Deployment Reference (Non-Conflicting Defaults)
# ------------------------------------------------------------------------------
# In Docker Compose, the following isolated configurations are applied:
# - Frontend: http://localhost:8080 (Proxies /api/ to backend:8000)
# - Backend:  http://localhost:8001 (Internal 8000)
# - Database: postgresql+asyncpg://postgres:postgres@db:5432/lenny_growth_db (Internal only)
# - Pi SDK:   http://pi-agent:8765 (Internal only)
# - Ollama:   http://host.docker.internal:11434 (Host loopback bridge)
# - GEMINI_API_KEY is automatically inherited from your root .env if provided.
